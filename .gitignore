# deps / build output
node_modules/
.expo/
dist/
web-build/
# CNG-generated native projects — ROOT ONLY. A bare `ios/` also matches
# modules/*/ios/, which silently kept every Swift file of the racquet-analyzer
# local module out of git: EAS built from the repo, shipped the module's JS with
# no native half, and `requireNativeModule('RacquetAnalyzer')` crashed on device
# while local builds (which compile from the working dir) were fine.
/ios/
/android/
*.log

# secrets — never commit these (lesson from daybot: keep credential files out of git)
.env*
credentials.json
google-services.json
play-service-account.json
*.p8
*.keystore
*.jks

# worktrees live inside the repo dir but are not content
.worktrees/

# generated
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo
npm-debug.*

# more credential-class files
*.p12
*.pem
*.mobileprovision
*.key

# os
.DS_Store

# analysis pipeline artifacts
analysis/samples/
analysis/.venv/
analysis/jobs/
analysis/out/**/pose_cache.pkl
analysis/out/**/_tmp/
__pycache__/
analysis/out/**/pose_cache*.pkl
# regenerable measurement cache written by analysis/tools/identity_audit.py
analysis/out/**/identity_gt_v1.pkl
analysis/eval/ball_align_cache/
