# Copy to analysis/.env (gitignored) and fill in. platform_api.py loads it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role JWT — server-only, never ship to clients>
STRIPE_SECRET_KEY=sk_test_...
# Optional: enables POST /billing/webhook signature verification
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
# Comma-separated allowlist of web-app origins checkout may return to;
# the first entry is the default when a request has no allowlisted Origin.
WEB_ORIGINS=https://<your-site>.azurestaticapps.net,http://localhost:5183
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
