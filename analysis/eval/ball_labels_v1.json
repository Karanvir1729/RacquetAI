 "schema": "ball_labels_v1",
 "labeller": "claude-opus-5, single pass, one labeller (no second opinion, so no inter-rater agreement figure)",
 "date": "2026-08-18",
 "plan": "eval/ball_sampling_plan.json (seed 20260818, salt ball-groundtruth)",
 "unitOfIndependence": "segment. Frames within a 12-frame segment are strongly correlated; any CI must bootstrap over segments, not frames.",
 "coordinates": "source video pixels at 854x480, origin top-left, ball CENTRE (centre of the streak when motion-blurred)",
 "readError": "positions were read off rulers printed in source pixels on magnified crops; repeatability is about +/-2 px, which is comparable to the ball itself",
 "protocol": [
  "1. Whole-frame aligned dark-residual TRAIL over the segment's 12 frames locates the ball's path, or shows there is no isolated mover.",
  "2. Where the path is unclear, 3-frame RGB composites (cyan=t-1, magenta=t, yellow=t+1) pin exact per-frame positions.",
  "3. Every position is then CONFIRMED BY EYE in the raw magnified pixels (>=3.5x nearest-neighbour) before it is written down, and the position is read from the raw crop, not from the composite.",
  "4. notVisible is only recorded after looking at the raw pixels at >=3.5x where the ball should be."
 ],
 "biasDisclosure": "This measures a CUED human: the aid says which neighbourhood to search, then the eye judges the raw pixels. That is the right ceiling for a detector that also has temporal context (frame differencing, or a TrackNet-style 3-frame stack), because such a detector gets the same motion evidence. It is NOT a free-search number and it is NOT a single-still number; a single-frame appearance-only detector faces a harder problem than this figure suggests. The aid is arithmetically a frame difference, so grading a differencing detector against these labels is partly circular and must be stated whenever it is done.",
 "knownLabellerError": "On archive_match3#0 a static wall blemish was first mis-called as the ball at 2.1x magnification and the real ball 30 px away was missed. The motion aid caught it. The >=3.5x rule in step 4 dates from that error; the two segments labelled before the rule (archive_match2#2, archive_match3#0) were re-checked under it.",
 "states": {
  "visible": "a human can put a pixel on the ball in the raw frame",
  "notVisible": "cannot, for the reason in 'miss'"
 },
 "missReasons": {
  "occludedByPlayer": "ball is behind or against a player's body",
  "sameColourAsClothing": "ball is over black kit; no separable edge",
  "darkStructure": "ball crosses a black glass-wall mullion or similar fixed dark structure",
  "lowContrastOnBrightPanel": "ball over a blown-out bright wall panel",
  "lowContrast+cameraJolt": "faint, and frame alignment is broken by a camera jolt",
  "offFrame": "rally is live but the ball is outside the camera's field of view",
  "cameraOffTarget": "operator is swinging the camera; much of the court is out of shot",
  "noBallInFlight": "dead ball: nobody is playing a shot in these frames"
 },
