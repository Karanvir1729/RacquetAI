    {
      "id": "pillarwhy-0291",
      "type": "text",
      "x": 12.0,
      "y": 2243.0,
      "width": 528.0,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
