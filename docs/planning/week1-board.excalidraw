      "text": "Network, storage & device limits",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Network, storage & device limits",
      "lineHeight": 1.25,
