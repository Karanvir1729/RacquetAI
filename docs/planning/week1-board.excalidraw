    {
      "id": "panelbody-0492",
      "type": "text",
      "x": 12.0,
      "y": 3652.5,
      "width": 541.2,
      "height": 510.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
