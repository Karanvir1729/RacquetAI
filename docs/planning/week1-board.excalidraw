    },
    {
      "id": "subtitle-0287",
      "type": "text",
      "x": 0.0,
      "y": 2145.5,
      "width": 2279.2,
      "height": 35.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1888112771,
      "version": 1,
      "versionNonce": 1409524537,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "Four pillars for the club product — Recording, Feedback, Data & Analytics, AI Coaching. P0 = needed for the first club pilot, P1 = needed to charge money, P2 = the moat later. One jurisdiction is P0 (Ontario, Canada — build to the UK GDPR engineering bar), everything in AI Coaching runs on Azure\nafter the match, and a single back-wall phone will never call a stroke, a serve fault or a not-up.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Four pillars for the club product — Recording, Feedback, Data & Analytics, AI Coaching. P0 = needed for the first club pilot, P1 = needed to charge money, P2 = the moat later. One jurisdiction is P0 (Ontario, Canada — build to the UK GDPR engineering bar), everything in AI Coaching runs on Azure\nafter the match, and a single back-wall phone will never call a stroke, a serve fault or a not-up.",
      "lineHeight": 1.25,
      "autoResize": true
    },
