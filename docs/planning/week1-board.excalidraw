    {
      "id": "panelbody-0284",
      "type": "text",
      "x": 1567.33,
      "y": 1486.5,
      "width": 726.0,
      "height": 210.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
