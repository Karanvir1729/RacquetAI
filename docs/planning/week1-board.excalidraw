      "versionNonce": 1168473863,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1755300000000,
      "link": null,
      "locked": false,
      "text": "Every box-league match becomes an asset with zero staff time and zero capital\nworks — the club's only spend is a clamp mount behind the glass. Nothing in this\npillar infers anything; no model runs in the app.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every box-league match becomes an asset with zero staff time and zero capital\nworks — the club's only spend is a clamp mount behind the glass. Nothing in this\npillar infers anything; no model runs in the app.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "feat-0293",
      "type": "rectangle",
      "x": 0.0,
      "y": 2312.0,
      "width": 567.25,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
